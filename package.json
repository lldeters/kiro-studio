        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.agents.new",
        "title": "%command.agents.new%",
        "category": "Kiro Studio",
        "icon": "$(add)"
      },
      {
        "command": "kiroStudio.agents.use",
        "title": "%command.agents.use%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.panel.refresh",
        "title": "%command.panel.refresh%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.openFile",
        "title": "%command.openFile%",
        "category": "Kiro Studio"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kiroStudio.newSession",
          "when": "view == kiroStudio.chat",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.openChatInEditor",
          "when": "view == kiroStudio.chat",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.checkSetup",
          "when": "view == kiroStudio.status",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.restart",
          "when": "view == kiroStudio.status",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.sessions.search",
          "when": "view == kiroStudio.sessions && !kiroStudio.sessionsSearching",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.sessions.clearSearch",
          "when": "view == kiroStudio.sessions && kiroStudio.sessionsSearching",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.sessions.showAll",
          "when": "view == kiroStudio.sessions && !kiroStudio.sessionsAll",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.sessions.showWorkspace",
          "when": "view == kiroStudio.sessions && kiroStudio.sessionsAll",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.sessions.refresh",
          "when": "view == kiroStudio.sessions",
          "group": "navigation@3"
        },
        {
          "command": "kiroStudio.specs.new",
          "when": "view == kiroStudio.specs",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.specs.refresh",
          "when": "view == kiroStudio.specs",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.steering.new",
          "when": "view == kiroStudio.steering",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.steering.generate",
          "when": "view == kiroStudio.steering",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.steering.refresh",
          "when": "view == kiroStudio.steering",
          "group": "navigation@3"
        },
        {
          "command": "kiroStudio.hooks.new",
          "when": "view == kiroStudio.hooks",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.hooks.refresh",
          "when": "view == kiroStudio.hooks",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.mcp.add",
          "when": "view == kiroStudio.mcp",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.mcp.openConfig",
          "when": "view == kiroStudio.mcp",
          "group": "navigation@2"
        },
        {
          "command": "kiroStudio.mcp.refresh",
          "when": "view == kiroStudio.mcp",
          "group": "navigation@3"
        },
        {
          "command": "kiroStudio.agents.new",
          "when": "view == kiroStudio.agents",
          "group": "navigation@1"
        },
        {
          "command": "kiroStudio.agents.refresh",
          "when": "view == kiroStudio.agents",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "kiroStudio.openFile",
          "when": "false"
        },
        {
          "command": "kiroStudio.sessions.open",
          "when": "false"
        },
        {
          "command": "kiroStudio.sessions.fork",
          "when": "false"
        },
        {
          "command": "kiroStudio.sessions.rename",
          "when": "false"
        },
        {
          "command": "kiroStudio.steering.delete",
          "when": "false"
        },
        {
          "command": "kiroStudio.steering.showBuiltin",
          "when": "false"
        },
        {
          "command": "kiroStudio.hooks.toggle",
          "when": "false"
        },
        {
          "command": "kiroStudio.mcp.toggle",
          "when": "false"
        },
        {
          "command": "kiroStudio.mcp.remove",
          "when": "false"
        },
        {
          "command": "kiroStudio.agents.use",
          "when": "false"
        },
        {
          "command": "kiroStudio.specs.openView",
          "when": "false"
        },
        {
          "command": "kiroStudio.specs.runTask",
          "when": "false"
        },
        {
          "command": "kiroStudio.specs.updateTasks",
          "when": "false"
        },
        {
          "command": "kiroStudio.fixProblem",
          "when": "false"
        },
        {
          "command": "kiroStudio.addSelectionToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "kiroStudio.explainSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "kiroStudio.fixSelection",
          "when": "editorIsOpen"
        },
        {
          "command": "kiroStudio.debug.newSession",
          "when": "kiroStudio.development"
        },
        {
          "command": "kiroStudio.debug.sendPrompt",
          "when": "kiroStudio.development"
        },
        {
          "command": "kiroStudio.debug.cancel",
          "when": "kiroStudio.development"
        },
        {
          "command": "kiroStudio.sessions.delete",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "kiroStudio.specs.runTask",
          "when": "view == kiroStudio.specs && viewItem =~ /canStart/",
          "group": "inline@1"
        },
        {
          "command": "kiroStudio.specs.updateTasks",
          "when": "view == kiroStudio.specs && viewItem =~ /specTasksFile/",
          "group": "inline@1"
        },
        {
          "command": "kiroStudio.specs.openView",
          "when": "view == kiroStudio.specs && viewItem == spec",
          "group": "inline@1"
        },
        {
          "command": "kiroStudio.specs.runTask",
          "when": "view == kiroStudio.specs && viewItem =~ /canStart/",
          "group": "1_spec@1"
        },
        {
          "command": "kiroStudio.specs.updateTasks",
          "when": "view == kiroStudio.specs && viewItem =~ /specTasksFile/",
          "group": "1_spec@1"
        },
        {
          "command": "kiroStudio.specs.openView",
          "when": "view == kiroStudio.specs && viewItem == spec",
          "group": "1_spec@1"
        },
        {
          "command": "kiroStudio.sessions.fork",
          "when": "view == kiroStudio.sessions && viewItem =~ /canFork/",
          "group": "inline@1"
        },
        {
          "command": "kiroStudio.sessions.rename",
          "when": "view == kiroStudio.sessions && viewItem =~ /canRename/",
          "group": "inline@2"
        },
        {
          "command": "kiroStudio.sessions.fork",
          "when": "view == kiroStudio.sessions && viewItem =~ /canFork/",
          "group": "1_session@1"
        },
        {
          "command": "kiroStudio.sessions.rename",
          "when": "view == kiroStudio.sessions && viewItem =~ /canRename/",
          "group": "1_session@2"
        },
        {
          "command": "kiroStudio.sessions.delete",
          "when": "view == kiroStudio.sessions && viewItem =~ /canDelete/",
          "group": "2_danger@1"
        },
        {
          "command": "kiroStudio.steering.delete",
          "when": "view == kiroStudio.steering && viewItem == steeringFile",
          "group": "inline"
        },
        {
          "command": "kiroStudio.steering.delete",
          "when": "view == kiroStudio.steering && viewItem == steeringFile",
          "group": "9_modification"
        },
        {
          "command": "kiroStudio.hooks.toggle",
          "when": "view == kiroStudio.hooks && viewItem =~ /^hook /",
          "group": "inline"
        },
        {
          "command": "kiroStudio.hooks.toggle",
          "when": "view == kiroStudio.hooks && viewItem =~ /^hook /",
          "group": "1_toggle"
        },
        {
          "command": "kiroStudio.mcp.toggle",
          "when": "view == kiroStudio.mcp && viewItem =~ /^mcpServer/",
          "group": "inline@1"
        },
        {
          "command": "kiroStudio.mcp.remove",
          "when": "view == kiroStudio.mcp && viewItem =~ /^mcpServer/",
          "group": "inline@2"
        },
        {
          "command": "kiroStudio.mcp.toggle",
          "when": "view == kiroStudio.mcp && viewItem =~ /^mcpServer/",
          "group": "1_toggle"
        },
        {
          "command": "kiroStudio.mcp.remove",
          "when": "view == kiroStudio.mcp && viewItem =~ /^mcpServer/",
          "group": "9_modification"
        },
        {
          "command": "kiroStudio.agents.use",
          "when": "view == kiroStudio.agents && viewItem == agentMode",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "submenu": "kiroStudio.editor",
          "group": "kiroStudio@1",
          "when": "resourceScheme == file"
        }
      ],
      "kiroStudio.editor": [
        {
          "command": "kiroStudio.addSelectionToChat",
          "group": "1_chat@1"
        },
        {
          "command": "kiroStudio.addFileToChat",
          "group": "1_chat@2"
        },
        {
          "command": "kiroStudio.explainSelection",
          "group": "2_ask@1"
        },
        {
          "command": "kiroStudio.fixSelection",
          "group": "2_ask@2"
        }
      ],
      "explorer/context": [
        {
          "command": "kiroStudio.addFileToChat",
          "group": "kiroStudio@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "kiroStudio.addFileToChat",
          "group": "kiroStudio@1",
          "when": "resourceScheme == file"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kiroStudio.addSelectionToChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == file"
      },
      {
        "command": "kiroStudio.openChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "!editorTextFocus || !editorHasSelection || resourceScheme != file"
      },
      {
        "command": "kiroStudio.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "focusedView == kiroStudio.chat || activeWebviewPanelId == kiroStudio.chatPanel"
      }
    ],
    "configuration": {
      "title": "Kiro Studio",
      "properties": {
        "kiroStudio.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.cliPath%"
        },
        "kiroStudio.autonomy": {
          "type": "string",
          "enum": [
            "supervised",
            "autopilot"
          ],
          "enumDescriptions": [
            "%config.autonomy.supervised%",
            "%config.autonomy.autopilot%"
          ],
          "default": "supervised",
          "scope": "application",
          "markdownDescription": "%config.autonomy%"
        },
        "kiroStudio.autoAllowInAutopilot": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%config.autoAllowInAutopilot%"
        },
        "kiroStudio.checkpoints.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.checkpointsEnabled%"
        },
        "kiroStudio.checkpoints.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%config.checkpointsExclude%"
        },
        "kiroStudio.checkpoints.maxFileSizeMB": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "%config.checkpointsMaxFileSize%"
        },
        "kiroStudio.planUsage.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%config.planUsageEnabled%"
        },
        "kiroStudio.mcp.addFromChat": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%config.mcpAddFromChat%"
        },
        "kiroStudio.hooks.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%config.hooksEnabled%"
        },
        "kiroStudio.specs.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.specsCodeLens%"
        },
        "kiroStudio.quickFix": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.quickFix%"
        },
        "kiroStudio.defaultMode": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%config.defaultMode%"
        },
        "kiroStudio.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.defaultModel%"
        },
        "kiroStudio.defaultEffort": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.defaultEffort%"
        },
        "kiroStudio.logging.level": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "%config.logging.off%",
            "%config.logging.messages%",
            "%config.logging.verbose%"
          ],
          "default": "messages",
          "markdownDescription": "%config.logging.level%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "kiroStudio.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "markdown": "resources/walkthrough/install.md"
            }
          },
          {
            "id": "signIn",
            "title": "%walkthrough.signIn.title%",
            "description": "%walkthrough.signIn.description%",
            "media": {
              "markdown": "resources/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:kiroStudio.state == ready"
            ]
          },
          {
            "id": "check",
            "title": "%walkthrough.check.title%",
            "description": "%walkthrough.check.description%",
            "media": {
              "markdown": "resources/walkthrough/check.md"
            }
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "kiroStudio.editor",
        "label": "%submenu.editor%"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs && npm run build:webview",
    "build:webview": "vite build --config webview-ui/vite.config.mts --mode development",
    "build:prod": "node esbuild.mjs --production && vite build --config webview-ui/vite.config.mts",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p webview-ui/tsconfig.json && tsc -p test/integration/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:integration": "tsc -p test/integration/tsconfig.json",
    "test:integration": "npm run build && npm run build:integration && vscode-test",
    "l10n:export": "tsx scripts/l10n-export.ts",
    "notices": "tsx scripts/third-party-notices.ts",
    "package": "npm run build:prod && npm run notices && vsce package --no-dependencies -o dist/kiro-studio.vsix && tsx scripts/check-vsix.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "release:check": "tsx scripts/check-release.ts",
    "vscode:prepublish": "npm run build:prod",
    "probe": "tsx scripts/probe-acp.ts",
    "validate-wire": "tsx scripts/validate-wire.ts",
    "preview": "tsx scripts/preview-webview.ts"
  },
