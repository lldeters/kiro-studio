{
  "name": "kiro-studio",
  "displayName": "Kiro Studio",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "lldeters",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#202020",
    "theme": "dark"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lldeters/kiro-studio.git"
  },
  "bugs": {
    "url": "https://github.com/lldeters/kiro-studio/issues"
  },
  "homepage": "https://github.com/lldeters/kiro-studio#readme",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "kiro",
    "acp",
    "agent client protocol",
    "ai",
    "agent"
  ],
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20.19"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "kiroStudio.defaultModel",
        "kiroStudio.defaultEffort"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kiro-studio",
          "title": "%viewsContainers.kiroStudio%",
          "icon": "resources/kiro-studio.svg"
        }
      ]
    },
    "views": {
      "kiro-studio": [
        {
          "type": "webview",
          "id": "kiroStudio.chat",
          "name": "%views.chat%",
          "visibility": "visible"
        },
        {
          "id": "kiroStudio.sessions",
          "name": "%views.sessions%",
          "visibility": "visible",
          "contextualTitle": "Kiro Studio"
        },
        {
          "id": "kiroStudio.specs",
          "name": "%views.specs%",
          "visibility": "collapsed",
          "contextualTitle": "Kiro Studio"
        },
        {
          "id": "kiroStudio.steering",
          "name": "%views.steering%",
          "visibility": "collapsed",
          "contextualTitle": "Kiro Studio"
        },
        {
          "id": "kiroStudio.hooks",
          "name": "%views.hooks%",
          "visibility": "collapsed",
          "contextualTitle": "Kiro Studio"
        },
        {
          "id": "kiroStudio.mcp",
          "name": "%views.mcp%",
          "visibility": "collapsed",
          "contextualTitle": "Kiro Studio"
        },
        {
          "id": "kiroStudio.agents",
          "name": "%views.agents%",
          "visibility": "collapsed",
          "contextualTitle": "Kiro Studio"
        },
        {
          "id": "kiroStudio.status",
          "name": "%views.status%",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kiroStudio.status",
        "when": "kiroStudio.state == untrusted",
        "contents": "%viewsWelcome.untrusted%"
      },
      {
        "view": "kiroStudio.status",
        "when": "kiroStudio.state == cliMissing",
        "contents": "%viewsWelcome.cliMissing%"
      },
      {
        "view": "kiroStudio.status",
        "when": "kiroStudio.state == tooOld",
        "contents": "%viewsWelcome.tooOld%"
      },
      {
        "view": "kiroStudio.status",
        "when": "kiroStudio.state == notSignedIn",
        "contents": "%viewsWelcome.notSignedIn%"
      },
      {
        "view": "kiroStudio.status",
        "when": "kiroStudio.state == error",
        "contents": "%viewsWelcome.error%"
      },
      {
        "view": "kiroStudio.status",
        "when": "kiroStudio.state == checking",
        "contents": "%viewsWelcome.checking%"
      },
      {
        "view": "kiroStudio.sessions",
        "when": "kiroStudio.state != ready",
        "contents": "%viewsWelcome.sessions.setup%"
      },
      {
        "view": "kiroStudio.sessions",
        "when": "kiroStudio.state == ready && !kiroStudio.agentReady",
        "contents": "%viewsWelcome.sessions.disconnected%"
      },
      {
        "view": "kiroStudio.sessions",
        "when": "kiroStudio.state == ready && kiroStudio.agentReady",
        "contents": "%viewsWelcome.sessions.empty%"
      },
      {
        "view": "kiroStudio.specs",
        "when": "true",
        "contents": "%viewsWelcome.specs%"
      },
      {
        "view": "kiroStudio.steering",
        "when": "true",
        "contents": "%viewsWelcome.steering%"
      },
      {
        "view": "kiroStudio.hooks",
        "when": "true",
        "contents": "%viewsWelcome.hooks%"
      },
      {
        "view": "kiroStudio.mcp",
        "when": "true",
        "contents": "%viewsWelcome.mcp%"
      },
      {
        "view": "kiroStudio.agents",
        "when": "true",
        "contents": "%viewsWelcome.agents%"
      }
    ],
    "commands": [
      {
        "command": "kiroStudio.openChat",
        "title": "%command.openChat%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.openChatInEditor",
        "title": "%command.openChatInEditor%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.exportSession",
        "title": "%command.exportSession%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.newSession",
        "title": "%command.newSession%",
        "category": "Kiro Studio",
        "icon": "$(add)"
      },
      {
        "command": "kiroStudio.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.addFileToChat",
        "title": "%command.addFileToChat%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.explainSelection",
        "title": "%command.explainSelection%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.fixSelection",
        "title": "%command.fixSelection%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.fixProblem",
        "title": "%command.fixProblem%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.stopTurn",
        "title": "%command.stopTurn%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.showQuickMenu",
        "title": "%command.showQuickMenu%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.checkSetup",
        "title": "%command.checkSetup%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.restart",
        "title": "%command.restart%",
        "category": "Kiro Studio",
        "icon": "$(debug-restart)"
      },
      {
        "command": "kiroStudio.login",
        "title": "%command.login%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.setCliPath",
        "title": "%command.setCliPath%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.toggleAutonomy",
        "title": "%command.toggleAutonomy%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.showProtocolLog",
        "title": "%command.showProtocolLog%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.showKiroLogs",
        "title": "%command.showKiroLogs%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.answerPending",
        "title": "%command.answerPending%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.refreshPlanUsage",
        "title": "%command.refreshPlanUsage%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.debug.newSession",
        "title": "%command.debug.newSession%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.debug.sendPrompt",
        "title": "%command.debug.sendPrompt%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.debug.cancel",
        "title": "%command.debug.cancel%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.sessions.refresh",
        "title": "%command.sessions.refresh%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.sessions.search",
        "title": "%command.sessions.search%",
        "category": "Kiro Studio",
        "icon": "$(search)"
      },
      {
        "command": "kiroStudio.sessions.clearSearch",
        "title": "%command.sessions.clearSearch%",
        "category": "Kiro Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "kiroStudio.sessions.showAll",
        "title": "%command.sessions.showAll%",
        "category": "Kiro Studio",
        "icon": "$(globe)"
      },
      {
        "command": "kiroStudio.sessions.showWorkspace",
        "title": "%command.sessions.showWorkspace%",
        "category": "Kiro Studio",
        "icon": "$(root-folder)"
      },
      {
        "command": "kiroStudio.sessions.open",
        "title": "%command.sessions.open%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.sessions.fork",
        "title": "%command.sessions.fork%",
        "category": "Kiro Studio",
        "icon": "$(repo-forked)"
      },
      {
        "command": "kiroStudio.sessions.rename",
        "title": "%command.sessions.rename%",
        "category": "Kiro Studio",
        "icon": "$(edit)"
      },
      {
        "command": "kiroStudio.sessions.delete",
        "title": "%command.sessions.delete%",
        "category": "Kiro Studio",
        "icon": "$(trash)"
      },
      {
        "command": "kiroStudio.specs.new",
        "title": "%command.specs.new%",
        "category": "Kiro Studio",
        "icon": "$(add)"
      },
      {
        "command": "kiroStudio.specs.openView",
        "title": "%command.specs.openView%",
        "category": "Kiro Studio",
        "icon": "$(preview)"
      },
      {
        "command": "kiroStudio.specs.runTask",
        "title": "%command.specs.runTask%",
        "category": "Kiro Studio",
        "icon": "$(play)"
      },
      {
        "command": "kiroStudio.specs.updateTasks",
        "title": "%command.specs.updateTasks%",
        "category": "Kiro Studio",
        "icon": "$(sparkle)"
      },
      {
        "command": "kiroStudio.specs.refresh",
        "title": "%command.specs.refresh%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.steering.refresh",
        "title": "%command.steering.refresh%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.steering.new",
        "title": "%command.steering.new%",
        "category": "Kiro Studio",
        "icon": "$(add)"
      },
      {
        "command": "kiroStudio.steering.generate",
        "title": "%command.steering.generate%",
        "category": "Kiro Studio",
        "icon": "$(sparkle)"
      },
      {
        "command": "kiroStudio.steering.delete",
        "title": "%command.steering.delete%",
        "category": "Kiro Studio",
        "icon": "$(trash)"
      },
      {
        "command": "kiroStudio.steering.showBuiltin",
        "title": "%command.steering.showBuiltin%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.hooks.refresh",
        "title": "%command.hooks.refresh%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.hooks.new",
        "title": "%command.hooks.new%",
        "category": "Kiro Studio",
        "icon": "$(add)"
      },
      {
        "command": "kiroStudio.hooks.toggle",
        "title": "%command.hooks.toggle%",
        "category": "Kiro Studio",
        "icon": "$(debug-pause)"
      },
      {
        "command": "kiroStudio.hooks.toggleFeature",
        "title": "%command.hooks.toggleFeature%",
        "category": "Kiro Studio"
      },
      {
        "command": "kiroStudio.mcp.refresh",
        "title": "%command.mcp.refresh%",
        "category": "Kiro Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "kiroStudio.mcp.openConfig",
        "title": "%command.mcp.openConfig%",
        "category": "Kiro Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kiroStudio.mcp.add",
        "title": "%command.mcp.add%",
        "category": "Kiro Studio",
        "icon": "$(add)"
      },
      {
        "command": "kiroStudio.mcp.toggle",
        "title": "%command.mcp.toggle%",
        "category": "Kiro Studio",
        "icon": "$(debug-pause)"
      },
      {
        "command": "kiroStudio.mcp.remove",
        "title": "%command.mcp.remove%",
        "category": "Kiro Studio",
        "icon": "$(trash)"
      },
      {
        "command": "kiroStudio.agents.refresh",
        "title": "%command.agents.refresh%",
